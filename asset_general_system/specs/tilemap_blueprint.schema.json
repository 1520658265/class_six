{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TilemapBlueprint",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "kind", "scene_id", "map_size", "tile_size", "layers", "materials"],
  "properties": {
    "version": {"type": "string"},
    "kind": {"const": "tilemap_blueprint"},
    "scene_id": {"type": "string"},
    "map_size": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 2,
      "maxItems": 2
    },
    "tile_size": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 2,
      "maxItems": 2
    },
    "layers": {
      "type": "object",
      "required": ["cells"],
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "layer", "material", "role"],
            "properties": {
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "layer": {"type": "string"},
              "material": {"type": "string"},
              "role": {"type": "string"},
              "reuse": {"type": "string"},
              "source_reason": {"type": "string"},
              "object_id": {"type": ["string", "null"]},
              "asset_id": {"type": ["string", "null"]},
              "source_generation_id": {"type": ["string", "null"]},
              "connection": {"type": "object", "additionalProperties": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "materials": {"type": "array", "items": {"type": "string"}},
    "adjacency_rules": {"type": "array", "items": {"type": "object"}},
    "generated_at": {"type": "string"}
  }
}
