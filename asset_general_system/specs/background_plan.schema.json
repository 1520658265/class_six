{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene Background Plan",
  "type": "object",
  "required": ["version", "kind", "concept_image", "tile_size", "map_size", "review_items"],
  "properties": {
    "version": {"type": "string"},
    "kind": {"const": "background_plan"},
    "scene_id": {"type": "string"},
    "concept_image": {"type": "string"},
    "tile_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 1}
    },
    "map_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 1}
    },
    "image_size": {
      "type": ["array", "null"],
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 1}
    },
    "background_image": {
      "type": "object",
      "properties": {
        "method": {
          "enum": ["review_required", "use_full_concept", "ignore"]
        },
        "status": {"type": "string"},
        "source_image": {"type": "string"},
        "output_path": {"type": "string"},
        "target_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 1}
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "method", "status"],
        "properties": {
          "id": {"type": "string"},
          "asset_id": {"type": "string"},
          "kind": {"type": "string"},
          "display_name": {"type": ["string", "null"]},
          "method": {
            "enum": ["extract_or_regenerate", "extract_from_concept", "extract_and_cleanup", "regenerate", "ignore"]
          },
          "status": {"type": "string"},
          "crop_rect": {
            "type": ["array", "null"],
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0}
          },
          "target_size": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 1}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "tile_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "kind", "generation_mode", "tile_size", "members"],
        "properties": {
          "group_id": {"type": "string"},
          "kind": {"enum": ["material_group", "transition_group"]},
          "generation_mode": {"const": "sprite_sheet"},
          "tile_size": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 1}
          },
          "from": {"type": "string"},
          "to": {"type": "string"},
          "display_name": {"type": ["string", "null"]},
          "prompt": {"type": ["string", "null"]},
          "sheet": {
            "type": "object",
            "properties": {
              "layout": {"enum": ["horizontal", "vertical", "grid"]},
              "columns": {"type": "integer", "minimum": 1},
              "gutter": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": true
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tile_id", "role"],
              "properties": {
                "tile_id": {"type": "string"},
                "role": {"type": "string"},
                "asset_id": {"type": "string"},
                "review_item_id": {"type": "string"},
                "source_ref": {"type": ["string", "null"]},
                "display_name": {"type": ["string", "null"]},
                "notes": {"type": ["string", "null"]},
                "properties": {"type": "object"}
              },
              "additionalProperties": true
            }
          },
          "properties": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "background_entities": {"type": "array"},
    "foreground_objects": {"type": "array"}
  },
  "additionalProperties": true
}
