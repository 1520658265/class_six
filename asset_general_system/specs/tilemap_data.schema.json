{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TilemapData",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "map", "tileset", "layers", "objects", "events", "regions", "metadata"],
  "properties": {
    "version": {"type": "string"},
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "tile_width", "tile_height", "orientation"],
      "properties": {
        "width": {"type": "integer"},
        "height": {"type": "integer"},
        "tile_width": {"type": "integer"},
        "tile_height": {"type": "integer"},
        "orientation": {"const": "orthogonal"}
      }
    },
    "tileset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "tile_width", "tile_height", "columns", "tile_count"],
      "properties": {
        "id": {"type": "string"},
        "image": {"type": "string"},
        "tile_width": {"type": "integer"},
        "tile_height": {"type": "integer"},
        "columns": {"type": "integer"},
        "tile_count": {"type": "integer"}
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terrain", "path", "building", "decoration", "collision"],
      "properties": {
        "terrain": {"type": "array", "items": {"type": "integer"}},
        "path": {"type": "array", "items": {"type": "integer"}},
        "building": {"type": "array", "items": {"type": "integer"}},
        "decoration": {"type": "array", "items": {"type": "integer"}},
        "collision": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "objects": {"$ref": "#/$defs/objectList"},
    "events": {"$ref": "#/$defs/objectList"},
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "bounds", "center", "access", "priority"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "bounds": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
          "center": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
          "access": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
          "priority": {"type": "integer"}
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "objectList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "x", "y", "width", "height", "properties"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "width": {"type": "integer"},
          "height": {"type": "integer"},
          "properties": {"type": "object"}
        }
      }
    }
  }
}

