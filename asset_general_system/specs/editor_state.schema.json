{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EditorStateDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_file", "map", "layer_visibility", "selection", "locked_regions", "metadata"],
  "properties": {
    "version": {"type": "string"},
    "source_file": {"type": ["string", "null"]},
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "tile_width", "tile_height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "tile_width": {"type": "integer", "minimum": 1},
        "tile_height": {"type": "integer", "minimum": 1}
      }
    },
    "layer_visibility": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "selection": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/selectionRect"}
      ]
    },
    "locked_regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/lockedRegion"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "selectionRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "lockedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "layers", "reason"],
      "properties": {
        "id": {"type": "string"},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "layers": {
          "anyOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "reason": {"type": "string"}
      }
    }
  }
}
